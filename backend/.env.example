# =============================================================================
# SymptomScope AI - Backend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# --- MongoDB ---
# MongoDB connection URI (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/symptomscope
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,https://symptomscope.vercel.app

# --- Clerk Authentication ---
# At least one of CLERK_JWKS_URL or CLERK_ISSUER is required
# CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
# CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Redis (optional - for rate limiting / caching) ---
# REDIS_URL=redis://localhost:6379

# --- App ---
DEBUG=false
APP_NAME=SymptomScope AI
APP_VERSION=1.0.0
SECRET_KEY=change-me-to-a-random-secret

# --- Gemini AI (LangChain) ---
# Required for LLM features (medical Q&A, explainer, follow-up questions)
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=1024

# --- Groq AI (required LLM provider) ---
# Get your key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TEMPERATURE=0.7
GROQ_MAX_TOKENS=2048

# --- RAG / Embeddings ---
CHROMADB_PATH=./ml/rag/chromadb
EMBEDDING_MODEL=models/embedding-001
RAG_TOP_K=5
RAG_SCORE_THRESHOLD=0.7

# --- Email (SMTP) ---
# Required for reminder emails and recovery-plan notifications.
# Without these, emails are skipped and the rest of the app still works.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=your-email@example.com

# --- Public base URL ---
# Used to build clickable links inside emails (e.g. reminder action buttons).
# PUBLIC_BASE_URL=https://symptomscope.vercel.app

# --- Dev mode ---
# When true (dev), auth falls back to dev-user-id if Clerk is unreachable.
DEV_MODE=true